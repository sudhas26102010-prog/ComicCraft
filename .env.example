# Copy this file to .env and fill in your own values.

# Required: Google Gemini API key (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=AQ.Ab8RN6K2WtJaa2ztXDzIXzzQYqE9mGVAx_Gv_lLQKsc9nB2d_g

# Optional: override the Gemini model names. "latest" aliases are used by
# default so the app keeps working as Google retires/upgrades model versions;
# pin to a specific version (e.g. gemini-2.5-flash) if you need reproducibility.
GEMINI_FLASH_MODEL=gemini-flash-latest
GEMINI_PRO_MODEL=gemini-flash-latest

# Which panel image backend to use:
#   cloud       - Pollinations.ai's free, keyless hosted Stable Diffusion API.
#                 Fast (seconds per image), nothing to download. Best for
#                 demos. Depends on a third-party free service being up.
#   local       - runs Stable Diffusion on this machine via Hugging Face
#                 Diffusers (needs torch/diffusers installed and a one-time
#                 ~2-4GB model download). Slower on CPU, but fully offline.
#   placeholder - instant colored placeholder images with the prompt text
#                 overlaid. No network calls at all; useful for testing the
#                 rest of the pipeline (Gemini + layout + PDF export) fast.
IMAGE_BACKEND=cloud

# Optional: Hugging Face token, only needed for IMAGE_BACKEND=local when the
# chosen Stable Diffusion checkpoint is gated/private on the Hub (the default
# checkpoint below is public and does not need this).
HF_API_KEY=your-huggingface-api-key-here

# Optional, only used when IMAGE_BACKEND=local: which Stable Diffusion
# checkpoint to use. Defaults to an anime-tuned, publicly-accessible SD1.5
# checkpoint. Note: many popular anime checkpoints on Hugging Face (e.g.
# Linaqruf/anything-v3.0) are gated and need HF_API_KEY.
SD_MODEL_ID=dreamlike-art/dreamlike-anime-1.0

# Optional, only used when IMAGE_BACKEND=local: force CPU inference even if
# a CUDA GPU is available.
FORCE_CPU=false
